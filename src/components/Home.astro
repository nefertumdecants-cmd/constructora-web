---
import Base from '../layouts/Base.astro';
import Proyectos from './Proyectos.tsx';
import T from './T.astro';
import { t } from '../i18n/ui';
import { sitio, waLink, secciones, pie } from '../config/sitio';
import { aviso, cifras, proceso, testimonios, titulos, proximamente, servicios, iconos, banda, textosPie } from '../data/contenido';
const { es, en } = t;
const tt = t;
const proyectos = Object.values(import.meta.glob('../data/proyectos/*.json', { eager: true, import: 'default' })) as any[];
---
<Base title={{ es: `${sitio.nombre} | ${es.portada.titulo}`, en: `${sitio.nombre} | ${en.portada.titulo}` }} description={{ es: es.portada.sub, en: en.portada.sub }}>
  <div class="bg-acento text-black text-center text-xs py-1 px-2"><T es={aviso.es} en={aviso.en} /></div>
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-gray-200">
    <nav class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between gap-4 text-sm">
      <a href="#" class="leading-tight"><span class="block font-extrabold tracking-wide text-marca text-lg">{sitio.nombre}</span><span class="block text-[10px] uppercase tracking-wider text-gray-500"><T es={sitio.subtitulo.es} en={sitio.subtitulo.en} /></span></a>
      <div class="flex items-center gap-4">
        <a class="hidden sm:inline" href="#nosotros"><T es={es.nav.nosotros} en={en.nav.nosotros} /></a>
        <a class="hidden sm:inline" href="#servicios"><T es={es.nav.servicios} en={en.nav.servicios} /></a>
        {secciones.proyectos && <a href="#proyectos"><T es={es.nav.proyectos} en={en.nav.proyectos} /></a>}
        <a class="hidden md:inline" href="#proceso"><T es={titulos.proceso.es} en={titulos.proceso.en} /></a>
        <a href="#contacto"><T es={es.nav.contacto} en={en.nav.contacto} /></a>
        <a href="#contacto" class="hidden sm:inline-block bg-acento text-white font-semibold px-4 py-2 rounded-full"><T es={es.portada.cotizar} en={en.portada.cotizar} /></a>
        <button type="button" data-lang-toggle aria-label="Cambiar idioma / Change language" class="border rounded px-2 py-1">
          <span data-l="es">EN</span><span data-l="en">ES</span>
        </button>
      </div>
    </nav>
  </header>

  <main>
    <section class="bg-gradient-to-br from-marca to-marca-oscuro text-white overflow-hidden">
      <div class="max-w-6xl mx-auto px-4 py-16 sm:py-24 grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-block rounded-full border border-acento/50 bg-acento/10 text-acento text-xs font-semibold tracking-widest px-4 py-1.5"><T es={es.portada.badge} en={en.portada.badge} /></span>
          <h1 class="mt-6 text-4xl sm:text-6xl font-extrabold leading-[1.05]">
            <span data-l="es">{es.portada.t1} <span class="text-acento">{es.portada.ac}</span> {es.portada.t2}</span>
            <span data-l="en">{en.portada.t1} <span class="text-acento">{en.portada.ac}</span> {en.portada.t2}</span>
          </h1>
          <p class="mt-6 text-lg text-white/80 max-w-xl"><T es={es.portada.sub} en={en.portada.sub} /></p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#servicios" class="bg-acento text-white font-semibold px-7 py-3 rounded-full"><T es={es.portada.cta} en={en.portada.cta} /></a>
            <a href="#contacto" class="border-2 border-white/80 text-white font-semibold px-7 py-3 rounded-full"><T es={es.portada.cta2} en={en.portada.cta2} /></a>
          </div>
        </div>
        <!-- Marcador de posición para la foto de obra. TODO(cliente): enviar fotografía real -->
        <div class="relative hidden lg:block h-[420px]" aria-hidden="true">
          <div class="absolute right-0 top-10 w-[78%] h-[85%] rounded-3xl bg-acento rotate-6 opacity-90"></div>
          <div class="absolute right-6 top-0 w-[78%] h-[85%] rounded-3xl bg-fondo text-marca grid place-items-center text-xl font-bold shadow-2xl">Obra en proceso</div>
          <div class="absolute left-0 bottom-6 bg-white text-marca rounded-2xl shadow-xl px-5 py-4 flex items-center gap-4">
            <span class="w-12 h-12 rounded-full bg-acento grid place-items-center text-white text-xl"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={iconos.edificio} /></svg></span>
            <span><span class="block text-xl font-extrabold"><T es={es.portada.anos} en={en.portada.anos} /></span><span class="block text-xs text-gray-500"><T es={es.portada.anosTxt} en={en.portada.anosTxt} /></span></span>
          </div>
        </div>
        <div class="lg:hidden flex items-center gap-3 bg-white text-marca rounded-2xl px-5 py-4 w-fit">
          <span class="w-10 h-10 rounded-full bg-acento grid place-items-center text-white" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={iconos.edificio} /></svg></span>
          <span><span class="block text-lg font-extrabold"><T es={es.portada.anos} en={en.portada.anos} /></span><span class="block text-xs text-gray-500"><T es={es.portada.anosTxt} en={en.portada.anosTxt} /></span></span>
        </div>
      </div>
    </section>

    <section id="nosotros" class="max-w-6xl mx-auto px-4 py-16">
      <h2 class="text-3xl font-bold mb-4"><T es={es.nosotros.titulo} en={en.nosotros.titulo} /></h2>
      <p class="max-w-2xl text-gray-700"><T es={es.nosotros.texto} en={en.nosotros.texto} /></p>
    </section>

    <section id="servicios" class="bg-white py-16">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl font-bold mb-8"><T es={es.servicios.titulo} en={en.servicios.titulo} /></h2>
        <ul class="grid gap-6 lg:grid-cols-3">
          {servicios.map((sv, i) => (
            <li class={`group rounded-2xl p-7 border transition duration-300 ease-out hover:shadow-2xl hover:border-acento motion-reduce:transition-none ${i === 1 ? 'bg-marca text-white border-marca lg:-translate-y-3 shadow-xl motion-safe:lg:hover:-translate-y-5' : 'bg-fondo text-black border-gray-200 motion-safe:hover:-translate-y-2'}`}>
              <span class={`w-12 h-12 rounded-xl grid place-items-center transition duration-300 group-hover:bg-acento group-hover:text-white motion-safe:group-hover:scale-110 motion-safe:group-hover:-rotate-6 ${i === 1 ? 'bg-acento text-white' : 'bg-white text-marca'}`}>
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={iconos[sv.icono]} /></svg>
              </span>
              <h3 class="mt-5 text-2xl font-bold"><T es={sv.titulo.es} en={sv.titulo.en} /></h3>
              <p class={`mt-3 text-sm leading-relaxed ${i === 1 ? 'text-white/85' : 'text-gray-700'}`}><T es={sv.texto.es} en={sv.texto.en} /></p>
              <ul class="mt-5 space-y-2 text-sm">
                {sv.items.es.map((it, j) => (
                  <li class="flex gap-2 transition-transform duration-300 motion-safe:group-hover:translate-x-1"><span class="text-acento font-bold" aria-hidden="true">&#10003;</span><T es={it} en={sv.items.en[j]} /></li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {!secciones.proyectos && (
      <section id="proximamente" class="max-w-6xl mx-auto px-4 py-16">
        <div class="rounded-2xl border-2 border-dashed border-marca/30 bg-white p-8 sm:p-12 text-center">
          <h2 class="text-3xl font-bold"><T es={proximamente.titulo.es} en={proximamente.titulo.en} /></h2>
          <p class="mt-3 max-w-xl mx-auto text-gray-700"><T es={proximamente.texto.es} en={proximamente.texto.en} /></p>
          {(['es', 'en'] as const).map((l) => (
            <a data-l={l} href={waLink(proximamente.mensaje[l])} target="_blank" rel="noopener noreferrer" class="inline-block mt-6 bg-green-600 text-white px-6 py-3 rounded font-semibold">{proximamente.boton[l]}</a>
          ))}
        </div>
      </section>
    )}

    {secciones.proyectos && (
    <section id="proyectos" class="max-w-6xl mx-auto px-4 py-16">
      <h2 class="text-3xl font-bold mb-6"><T es={es.proyectos.titulo} en={en.proyectos.titulo} /></h2>
      <Proyectos client:visible proyectos={proyectos} />
    </section>
    )}

    {secciones.cifras && (
    <section id="cifras" class="bg-marca text-white py-16">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl font-bold mb-8"><T es={titulos.cifras.es} en={titulos.cifras.en} /></h2>
        <dl class="grid grid-cols-2 lg:grid-cols-4 gap-8">
          {cifras.map((c) => (
            <div>
              <dd class="text-3xl sm:text-4xl xl:text-5xl font-extrabold text-acento whitespace-nowrap"><span data-contar={c.valor}>{c.valor.toLocaleString('es')}</span><span class={c.sufijo.trim() === '+' ? '' : 'text-[0.5em] font-bold ml-1'}>{c.sufijo.trim()}</span></dd>
              <dt class="mt-1 text-white/80 text-sm"><T es={c.etiqueta.es} en={c.etiqueta.en} /></dt>
            </div>
          ))}
        </dl>
      </div>
    </section>
    )}

    <section id="proceso" class="max-w-6xl mx-auto px-4 py-16">
      <h2 class="text-3xl font-bold mb-8"><T es={titulos.proceso.es} en={titulos.proceso.en} /></h2>
      <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {proceso.map((p, i) => (
          <li class="relative bg-white rounded-xl border border-gray-200 p-5">
            <span class="absolute -top-3 left-5 bg-acento text-black font-bold w-8 h-8 grid place-items-center rounded-full">{i + 1}</span>
            <h3 class="mt-3 font-bold"><T es={p.titulo.es} en={p.titulo.en} /></h3>
            <p class="mt-1 text-sm text-gray-600"><T es={p.texto.es} en={p.texto.en} /></p>
          </li>
        ))}
      </ol>
    </section>

    {secciones.testimonios && (
    <section id="testimonios" class="bg-white py-16">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl font-bold mb-8"><T es={titulos.testimonios.es} en={titulos.testimonios.en} /></h2>
        <ul class="grid gap-6 md:grid-cols-3">
          {testimonios.map((t) => (
            <li class="rounded-xl border border-gray-200 p-6 bg-fondo">
              <blockquote class="text-gray-700"><span class="text-acento text-3xl leading-none" aria-hidden="true">“</span><T es={t.texto.es} en={t.texto.en} /></blockquote>
              <p class="mt-4 font-semibold">{t.nombre}</p>
              <p class="text-sm text-gray-500"><T es={t.rol.es} en={t.rol.en} /></p>
            </li>
          ))}
        </ul>
      </div>
    </section>
    )}

    <section id="contacto" class="bg-white py-16">
      <div class="max-w-xl mx-auto px-4">
        <h2 class="text-3xl font-bold mb-6"><T es={es.contacto.titulo} en={en.contacto.titulo} /></h2>
        <form id="form-contacto" class="grid gap-4" data-wa={sitio.whatsapp}>
          <label class="grid gap-1 text-sm"><T es={es.contacto.nombre} en={en.contacto.nombre} /><input required name="nombre" class="border rounded px-3 py-2" /></label>
          <label class="grid gap-1 text-sm"><T es={es.contacto.correo} en={en.contacto.correo} /><input required type="email" name="correo" class="border rounded px-3 py-2" /></label>
          {secciones.proyectos && (
          <label class="grid gap-1 text-sm"><T es={es.contacto.proyecto} en={en.contacto.proyecto} />
            <select name="proyecto" id="campo-proyecto" class="border rounded px-3 py-2">
              <option value="">—</option>
              {proyectos.map((p) => <option value={p.id} data-es={p.nombre.es} data-en={p.nombre.en}>{p.nombre.es}</option>)}
            </select>
          </label>
          )}
          <label class="grid gap-1 text-sm"><T es={es.contacto.mensaje} en={en.contacto.mensaje} /><textarea required name="mensaje" rows="4" class="border rounded px-3 py-2"></textarea></label>
          <button class="bg-marca text-white py-3 rounded font-semibold"><T es={es.contacto.enviar} en={en.contacto.enviar} /></button>
          <p class="text-xs text-gray-500"><T es={es.contacto.nota} en={en.contacto.nota} /></p>
        </form>
      </div>
    </section>
  </main>

  <!-- Franja de llamado a la acción (de la maqueta del cliente) -->
  <section class="bg-acento py-12 text-center" style="background-image: radial-gradient(rgba(255,255,255,.18) 1.5px, transparent 1.5px); background-size: 22px 22px;">
    <div class="max-w-6xl mx-auto px-4">
      {(['es', 'en'] as const).map((l) => (
        <a data-l={l} href={waLink(banda.mensaje[l])} target="_blank" rel="noopener noreferrer" class="inline-block bg-marca text-white font-semibold px-8 py-4 rounded-full shadow-lg transition duration-300 motion-safe:hover:-translate-y-1 hover:shadow-2xl">{banda.boton[l]}</a>
      ))}
    </div>
  </section>

  <footer class="bg-marca text-white">
    <div class="max-w-6xl mx-auto px-4 pt-14 pb-24">
      <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1.2fr]">
        <div>
          <p class="leading-tight"><span class="block text-2xl font-extrabold tracking-wide">{sitio.nombre}</span><span class="block text-[10px] uppercase tracking-wider text-white/60"><T es={sitio.subtitulo.es} en={sitio.subtitulo.en} /></span></p>
          <p class="mt-5 text-sm text-white/75 max-w-sm"><T es={textosPie.descripcion.es} en={textosPie.descripcion.en} /></p>
          <div class="mt-6 flex gap-3">
            {([
              ['facebook', 'Facebook', 'M13.5 21v-7.5H16l.5-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H8v3h2.5V21h3z'],
              ['instagram', 'Instagram', ''],
              ['linkedin', 'LinkedIn', 'M6.5 9H3.5v11h3V9zM5 4a1.7 1.7 0 1 0 0 3.4A1.7 1.7 0 0 0 5 4zM20.5 20h-3v-5.4c0-1.4-.5-2.3-1.7-2.3-1 0-1.6.7-1.8 1.3-.1.2-.1.5-.1.8V20h-3s.1-9.6 0-11h3v1.6c.4-.7 1.1-1.6 2.8-1.6 2 0 3.8 1.3 3.8 4.2V20z'],
            ] as const).map(([k, nombre, d]) => {
              const url = pie.redes[k];
              const Tag = url ? 'a' : 'span';
              return (
                <Tag href={url || undefined} target={url ? '_blank' : undefined} rel={url ? 'noopener noreferrer' : undefined} aria-label={nombre}
                  class={`w-10 h-10 rounded-full bg-white/10 grid place-items-center transition ${url ? 'hover:bg-acento' : 'opacity-60'}`}>
                  {k === 'instagram'
                    ? <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4.5" /><circle cx="12" cy="12" r="3.6" /><circle cx="17" cy="7" r=".8" fill="currentColor" /></svg>
                    : <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={d} /></svg>}
                </Tag>
              );
            })}
          </div>
        </div>

        <nav aria-label={textosPie.enlaces.es}>
          <h2 class="font-bold text-lg"><T es={textosPie.enlaces.es} en={textosPie.enlaces.en} /></h2>
          <ul class="mt-4 space-y-3 text-sm text-white/80">
            <li><a class="hover:text-acento transition" href="#">&rsaquo; <T es={textosPie.inicio.es} en={textosPie.inicio.en} /></a></li>
            <li><a class="hover:text-acento transition" href="#nosotros">&rsaquo; <T es={textosPie.nosotros.es} en={textosPie.nosotros.en} /></a></li>
            <li><a class="hover:text-acento transition" href="#servicios">&rsaquo; <T es={textosPie.servicios.es} en={textosPie.servicios.en} /></a></li>
            <li>
              {secciones.proyectos
                ? <a class="hover:text-acento transition" href="#proyectos">&rsaquo; <T es={textosPie.proyectos.es} en={textosPie.proyectos.en} /></a>
                : <span>&rsaquo; <T es={textosPie.proyectos.es} en={textosPie.proyectos.en} /> <T es={textosPie.proximamente.es} en={textosPie.proximamente.en} /></span>}
            </li>
          </ul>
        </nav>

        <div>
          <h2 class="font-bold text-lg"><T es={textosPie.contacto.es} en={textosPie.contacto.en} /></h2>
          <ul class="mt-4 space-y-3 text-sm text-white/80">
            <li class="flex gap-3"><span class="text-acento" aria-hidden="true">&#9679;</span>{pie.direccion}</li>
            <li class="flex gap-3"><span class="text-acento" aria-hidden="true">&#9679;</span><a class="hover:text-acento transition" href={waLink('')}>{pie.telefono}</a></li>
            <li class="flex gap-3"><span class="text-acento" aria-hidden="true">&#9679;</span><a class="hover:text-acento transition break-all" href={`mailto:${sitio.correo}`}>{sitio.correo}</a></li>
          </ul>
        </div>
      </div>

      <div class="mt-12 pt-6 border-t border-white/10 flex flex-wrap gap-x-8 gap-y-2 justify-between text-xs text-white/55">
        <p>&copy; {new Date().getFullYear()} {sitio.nombre} <T es={sitio.subtitulo.es} en={sitio.subtitulo.en} />. <T es={textosPie.derechos.es} en={textosPie.derechos.en} /></p>
        <p class="flex gap-5"><span><T es={textosPie.terminos.es} en={textosPie.terminos.en} /></span><span><T es={textosPie.privacidad.es} en={textosPie.privacidad.en} /></span></p>
      </div>
    </div>
  </footer>

  {(['es', 'en'] as const).map((l) => (
    <a data-l={l} href={waLink(l === 'es' ? 'Hola, quisiera más información.' : 'Hello, I would like more information.')} target="_blank" rel="noopener noreferrer"
      class="fixed bottom-4 right-4 z-40 bg-green-500 text-white px-4 py-3 rounded-full shadow-lg text-sm font-semibold">
      <span class="sr-only">{tt[l].wa}</span>WhatsApp
    </a>
  ))}

  <script is:inline>
    // Formulario -> WhatsApp: arma el mensaje con todo lo que escribió el prospecto.
    (function () {
      var f = document.getElementById('form-contacto');
      if (!f) return;
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        var en = document.documentElement.lang === 'en';
        var v = function (n) { return (f.elements[n].value || '').trim(); };
        var sel = f.elements.proyecto; var proy = sel && sel.value ? sel.options[sel.selectedIndex].textContent : '';
        var L = en ? ['Hello, I am', 'Email', 'Project', 'Ref', 'Message'] : ['Hola, soy', 'Correo', 'Proyecto', 'Ref', 'Mensaje'];
        var txt = L[0] + ' ' + v('nombre') + '.\n' + L[1] + ': ' + v('correo') + '\n' +
          (proy ? L[2] + ': ' + proy + ' (' + L[3] + ': ' + sel.value + ')\n' : '') + L[4] + ': ' + v('mensaje');
        var url = 'https://wa.me/' + f.dataset.wa + '?text=' + encodeURIComponent(txt);
        var w = window.open(url, '_blank'); // sin 'noopener' para poder detectar si el navegador lo bloqueó
        if (w) w.opener = null; else location.href = url;
      });
    })();
    // Contador animado de cifras; sin animación si la persona prefiere menos movimiento.
    (function () {
      var els = document.querySelectorAll('[data-contar]');
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (!e.isIntersecting) return; io.unobserve(e.target);
          var fin = +e.target.dataset.contar, t0 = performance.now();
          (function paso(t) {
            var k = Math.min((t - t0) / 1200, 1);
            e.target.textContent = Math.round(fin * (1 - Math.pow(1 - k, 3))).toLocaleString('es');
            if (k < 1) requestAnimationFrame(paso);
          })(t0);
        });
      }, { threshold: 0.4 });
      els.forEach(function (el) { io.observe(el); });
    })();
    const p = new URLSearchParams(location.search).get('proyecto');
    const c = document.getElementById('campo-proyecto');
    if (p && c) c.value = p;
  </script>
</Base>
